# Copy to .env and fill in the API key.
# TritonAI (UCSD CSE 190 OpenAI-compatible gateway)
TRITON_API_KEY=
TRITON_BASE_URL=https://tritonai-api.ucsd.edu/v1
LLM_MODEL=claude-sonnet-4-6
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=90

# Storage / DB (relative to backend/ cwd when launched via make dev)
DATA_DIR=./data
UPLOADS_DIR=./data/uploads
DB_URL=sqlite:///./data/app.db

# Validity gate threshold (0.0–1.0)
VALIDITY_CONFIDENCE_THRESHOLD=0.5
MAX_ALIAS_INJECTION=200
